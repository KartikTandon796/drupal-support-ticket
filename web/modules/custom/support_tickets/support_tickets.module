<?php

/**
 * @file
 * Hooks and theme registrations for the Support Tickets module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\support_tickets\Entity\TicketComment;
use Drupal\support_tickets\Entity\TicketInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function support_tickets_theme($existing, $type, $theme, $path): array {
  return [
    'support_ticket' => [
      'render element' => 'elements',
      'template' => 'support-ticket',
    ],
  ];
}

/**
 * Implements hook_views_pre_render().
 */
function support_tickets_views_pre_render(ViewExecutable $view): void {
  if ($view->id() === 'support_tickets') {
    $view->element['#attached']['library'][] = 'support_tickets/support_tickets';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function support_tickets_preprocess_views_view(array &$variables): void {
  if (($variables['view']->id() ?? '') !== 'support_tickets') {
    return;
  }
  $variables['attributes']['class'][] = 'support-tickets-view';
  $variables['can_create'] = \Drupal::currentUser()->hasPermission('create support tickets');
  $variables['add_ticket_url'] = Url::fromRoute('entity.support_ticket.add_form')->toString();
}

/**
 * Implements hook_preprocess_HOOK() for views_view_field.
 *
 * Wraps status and priority cell output in badge markup.
 */
function support_tickets_preprocess_views_view_field(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  $field = $variables['field'] ?? NULL;
  if (!$view || !$field || $view->id() !== 'support_tickets') {
    return;
  }

  $field_id = $field->field ?? '';
  if (!in_array($field_id, ['status', 'priority', 'title', 'edit_support_ticket'], TRUE)) {
    return;
  }

  $entity = $variables['row']->_entity ?? NULL;
  if (!$entity instanceof TicketInterface) {
    return;
  }

  if ($field_id === 'title') {
    $url = $entity->toUrl('canonical')->toString();
    $variables['output'] = Markup::create(
      '<a href="' . htmlspecialchars($url, ENT_QUOTES, 'UTF-8') . '">' .
      htmlspecialchars($entity->getTitle(), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') .
      '</a>'
    );
    return;
  }

  if ($field_id === 'edit_support_ticket') {
    if (!$entity->access('update')) {
      $variables['output'] = Markup::create('');
      return;
    }
    $url = $entity->toUrl('edit-form')->toString();
    $variables['output'] = Markup::create(
      '<a class="support-tickets-table__edit" href="' . htmlspecialchars($url, ENT_QUOTES, 'UTF-8') . '">' .
      htmlspecialchars((string) t('Edit'), ENT_QUOTES, 'UTF-8') .
      '</a>'
    );
    return;
  }

  if ($field_id === 'status') {
    $machine = $entity->getStatusValue();
    $label = TicketInterface::STATUSES[$machine] ?? $machine;
    $class = 'st-badge st-badge--status-' . $machine;
  }
  else {
    $machine = $entity->getPriority();
    $label = TicketInterface::PRIORITIES[$machine] ?? $machine;
    $class = 'st-badge st-badge--priority-' . $machine;
  }

  $variables['output'] = Markup::create(
    '<span class="' . htmlspecialchars($class, ENT_QUOTES, 'UTF-8') . '">' .
    htmlspecialchars($label, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') .
    '</span>'
  );
}

/**
 * Implements hook_form_FORM_ID_alter() for Views exposed filters.
 */
function support_tickets_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'support_tickets') {
    return;
  }
  $form['#attributes']['class'][] = 'support-tickets-exposed-form';
  $form['#attributes']['class'][] = 'form--inline';

  // Present status as a select (base-field string filters default to textfield).
  if (isset($form['status'])) {
    $current = $form['status']['#default_value'] ?? '';
    if (is_array($current)) {
      $current = reset($current) ?: '';
    }
    $form['status'] = [
      '#type' => 'select',
      '#title' => t('Status'),
      '#options' => ['' => t('- Any -')] + TicketInterface::STATUSES,
      '#default_value' => $current,
    ];
  }
}

/**
 * Prepares variables for support_ticket templates.
 *
 * Default template: support-ticket.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: Structured array of ticket content.
 */
function template_preprocess_support_ticket(array &$variables): void {
  /** @var \Drupal\support_tickets\Entity\TicketInterface $ticket */
  $ticket = $variables['elements']['#support_ticket'];
  $variables['ticket'] = $ticket;
  $variables['attributes']['class'][] = 'support-ticket-detail';

  $status = $ticket->getStatusValue();
  $priority = $ticket->getPriority();

  $variables['title'] = $ticket->getTitle();
  $variables['description'] = (string) $ticket->get('description')->value;
  $variables['status'] = $status;
  $variables['status_label'] = TicketInterface::STATUSES[$status] ?? $status;
  $variables['priority'] = $priority;
  $variables['priority_label'] = TicketInterface::PRIORITIES[$priority] ?? $priority;

  $assignee = $ticket->get('assigned_to')->entity;
  $variables['assignee_label'] = $assignee ? $assignee->label() : (string) t('Unassigned');

  $owner = $ticket->getOwner();
  $variables['created_by_label'] = $owner ? $owner->label() : (string) t('Unknown');

  $date_formatter = \Drupal::service('date.formatter');
  $variables['created_formatted'] = $date_formatter->format((int) $ticket->get('created')->value, 'medium');
  $variables['changed_formatted'] = $date_formatter->format((int) $ticket->get('changed')->value, 'medium');
  $variables['back_url'] = Url::fromRoute('view.support_tickets.page_list')->toString();
  $variables['comments'] = $variables['elements']['#support_ticket_comments'] ?? [];

  $variables['content'] = [];
  foreach (Element::children($variables['elements']) as $key) {
    if (in_array($key, ['comment_form', 'ticket_update'], TRUE)) {
      $variables['content'][$key] = $variables['elements'][$key];
    }
  }

  $variables['elements']['#attached']['library'][] = 'support_tickets/support_tickets';
}

/**
 * Implements hook_ENTITY_TYPE_view() for support_ticket.
 */
function support_tickets_support_ticket_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if ($view_mode !== 'full' || !$entity instanceof TicketInterface) {
    return;
  }

  $build['#attached']['library'][] = 'support_tickets/support_tickets';

  foreach (['title', 'description', 'priority', 'status', 'assigned_to', 'created_by', 'created', 'changed'] as $field_name) {
    if (isset($build[$field_name])) {
      $build[$field_name]['#access'] = FALSE;
    }
  }

  $comment_storage = \Drupal::entityTypeManager()->getStorage('support_ticket_comment');
  $cids = $comment_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('ticket_id', $entity->id())
    ->sort('created', 'ASC')
    ->execute();
  /** @var \Drupal\support_tickets\Entity\TicketCommentInterface[] $comments */
  $comments = $comment_storage->loadMultiple($cids);

  $comment_items = [];
  $date_formatter = \Drupal::service('date.formatter');
  foreach ($comments as $comment) {
    $author = $comment->getOwner();
    $comment_items[] = [
      'author' => $author ? $author->label() : (string) t('Unknown'),
      'created' => $date_formatter->format((int) $comment->get('created')->value, 'medium'),
      'message' => $comment->getMessage(),
    ];
  }
  $build['#support_ticket_comments'] = $comment_items;

  $form_builder = \Drupal::service('entity.form_builder');

  if ($entity->access('update')) {
    $build['ticket_update'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'support-ticket-detail__panel',
          'support-ticket-detail__panel--actions',
        ],
      ],
      '#weight' => 60,
      'title' => [
        '#markup' => '<h2 class="support-ticket-detail__panel-title">' . t('Update ticket') . '</h2>',
      ],
      'form' => $form_builder->getForm($entity, 'edit'),
    ];
  }

  if (\Drupal::currentUser()->hasPermission('add support ticket comments')) {
    $new_comment = TicketComment::create([
      'ticket_id' => $entity->id(),
    ]);
    $build['comment_form'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'support-ticket-detail__panel',
          'support-ticket-detail__panel--comment-form',
        ],
      ],
      '#weight' => 70,
      'title' => [
        '#markup' => '<h2 class="support-ticket-detail__panel-title">' . t('Add a comment') . '</h2>',
      ],
      'form' => $form_builder->getForm($new_comment, 'add'),
    ];
  }
}
